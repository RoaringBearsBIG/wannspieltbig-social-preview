# Public base URL of the share pages (used for og:url / og:image / twitter:image)
SHARE_BASE_URL=https://bot.wannspieltbig.de

# wannspieltbig match API the share pages read from
ESPORTS_API_URL=https://wannspieltbig.de/api/match_upcoming/

# Listen port inside the container (no published port — nginx reaches us via dashboard-network)
PORT=8080

# Interval of the background image pre-warmer
WARM_INTERVAL_MINUTES=15
